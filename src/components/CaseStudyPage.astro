---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ThesisScene from '../components/ThesisScene.astro';
import ProjectDiagram from '../components/ProjectDiagram.astro';
import type { Project } from '../data/portfolio';
import { localizedProjects, localizedPath, translate, type Language } from '../lib/i18n';
const {project, language = 'en'} = Astro.props as {project: Project; language?: Language};
const projects = localizedProjects(language);
const path = (value = '') => localizedPath(language,value);
const t = (text: string) => translate(language,text);
const next=projects[(projects.findIndex(p=>p.slug===project.slug)+1)%projects.length];
---
<Layout language={language} title={`${project.shortTitle} — Francesco Di Lucia`} description={project.summary}>
  <div class="wrap case-study"><a class="back-link mono" href={path('#work')}>{t("← ALL WORK")}</a><div class="case-hero"><span class="eyebrow mono">{project.number} / {project.category}</span><h1>{project.title}</h1><p class="case-summary">{project.summary}</p><div class="case-meta"><div><span class="mono">{t("CONTEXT & ROLE")}</span><p>{project.role}</p></div><div><span class="mono">{t("TOOLS")}</span><ul class="stack">{project.stack.map(s=><li>{s}</li>)}</ul></div><a class="case-link" href={project.repo}>{t("View source")} <Arrow diagonal /></a></div></div>
  {project.slug==='multispectral-thesis' ? <ThesisScene expanded language={language} /> : <ProjectDiagram kind={project.slug} language={language} />}
  <div class="case-body"><aside><span class="eyebrow mono">{t("THE QUESTION")}</span><p>{project.question}</p><a class="case-link" href={project.repo}>{t("Repository")} <Arrow diagonal /></a></aside><div class="case-narrative">{project.sections.map((section,i)=><section><span class="eyebrow mono">{String(i+1).padStart(2,'0')} / {t(i===project.sections.length-1?'REFLECTION':'PROCESS')}</span><h2>{section.title}</h2>{section.paragraphs.map(p=><p>{p}</p>)}</section>)}
    {project.slug==='multispectral-thesis' && <section class="results"><span class="eyebrow mono">{t("REPORTED THESIS RESULTS")}</span><h2>{t("Two configurations, two trade-offs.")}</h2><div class="table-scroll"><table><caption>{t("Held-out patch classification · defense presentation, final comparison")}</caption><thead><tr><th scope="col">{t("Configuration")}</th><th scope="col">{t("Accuracy")}</th><th scope="col">{t("F1")}</th></tr></thead><tbody><tr><th scope="row">{t("ResNet18 · VI only · square crop")}</th><td>{language === "it" ? "65,46%" : "65.46%"}</td><td>{language === "it" ? "72,43%" : "72.43%"}</td></tr><tr><th scope="row">{t("Deeper residual-SE · MS + VI · square crop")}</th><td>{language === "it" ? "68,10%" : "68.10%"}</td><td>{language === "it" ? "71,53%" : "71.53%"}</td></tr></tbody></table></div><p class="result-note">{t("Reported in my thesis defense (final results comparison, slide 27). The best F1 and best accuracy come from different models. These are dataset-specific experimental results; they have not been independently reproduced for this portfolio.")}</p></section>}
  </div></div><div class="next-project"><span class="eyebrow mono">{t("NEXT EXPLORATION")}</span><a href={path(`work/${next.slug}/`)}>{next.shortTitle}<Arrow diagonal /></a></div></div>
</Layout>
