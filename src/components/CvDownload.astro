---
import { path } from '../lib/paths';
import { translate, type Language } from '../lib/i18n';
const { language = 'en', compact = false } = Astro.props as { language?: Language; compact?: boolean };
---
<a class:list={['cv-download', { 'cv-compact': compact }]} href={path('Francesco-di-Lucia-CV.pdf')} download="Francesco-di-Lucia-CV.pdf">
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg>
  <span>{translate(language, 'Download CV')}</span><small class="mono">PDF · EN</small>
</a>
