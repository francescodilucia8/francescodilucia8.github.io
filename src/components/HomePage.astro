---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import FieldGlyph from '../components/FieldGlyph.astro';
import ThesisScene from '../components/ThesisScene.astro';
import ProjectDiagram from '../components/ProjectDiagram.astro';
import { profile as sharedProfile } from '../data/portfolio';
import { localizedProjects, localizedPath, translate, type Language } from '../lib/i18n';
import { path as assetPath } from '../lib/paths';
const {language = 'en'} = Astro.props as {language?: Language};
const t = (text: string) => translate(language,text);
const path = (value = '') => localizedPath(language,value);
const projects = localizedProjects(language);
const profile = {...sharedProfile,location:t(sharedProfile.location),education:t(sharedProfile.education)};
const thesis=projects[0];
---
<Layout home language={language}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-intro mono"><span><i class="status-dot" aria-hidden="true"></i> {t("AI / ML & SOFTWARE ENGINEERING")}</span><span>{profile.location}</span></div>
    <div class="hero-composition"><div class="hero-heading"><p class="hero-name">{t("Hi, I’m Francesco.")}</p><h1 id="hero-title"><span>{t("Before creating the software,")}</span>{" "}<em>{t("I find the pattern in the data")}</em></h1></div><div class="hero-art"><FieldGlyph id="hero" /></div></div>
    <div class="hero-bottom"><p>{t("I develop and research machine learning systems and algorithms that I then go on to integrate into software applications.")}</p><a class="primary-link" href="#work">{t("Explore my work")} <span><Arrow /></span></a></div>
    <div class="hero-foot mono"><a href="#work" aria-label={t("Scroll to selected work")}>{t("SCROLL TO EXPLORE")} <span aria-hidden="true">{t("↓")}</span></a></div>
  </section>
  <section id="work" class="work-section wrap" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow mono">{t("01 / SELECTED WORK")}</span><h2 id="work-title">{t("From ideas to banging my head against the wall to give them shape")}</h2></div></div>
    <article class="featured-project">
      <div class="project-copy"><div class="project-meta mono"><span>{t("01")}</span><span>{thesis.status}</span></div><h3><a href={path(`work/${thesis.slug}/`)}>{thesis.title}</a></h3><p>{thesis.summary}</p><ul class="stack" aria-label={t("Technologies")}>{thesis.stack.map(s=><li>{s}</li>)}</ul><a class="case-link" href={path(`work/${thesis.slug}/`)}>{t("Explore the study")} <Arrow diagonal /></a></div>
      <ThesisScene language={language} />
    </article>
    <div class="project-pair">{projects.slice(1).map(project=><article class="project-card"><ProjectDiagram kind={project.slug} language={language} /><div class="project-card-copy"><div class="project-meta mono"><span>{project.number}</span><span>{project.status}</span></div><h3><a href={path(`work/${project.slug}/`)}>{project.title}</a></h3><p>{project.summary}</p><div class="card-bottom"><ul class="stack" aria-label={t("Technologies")}>{project.stack.map(s=><li>{s}</li>)}</ul><a class="round-link" href={path(`work/${project.slug}/`)} aria-label={language === "it" ? `Leggi il progetto ${project.shortTitle}` : `Read ${project.shortTitle} case study`}><Arrow diagonal /></a></div></div></article>)}</div>
    <div class="supporting"><span class="eyebrow mono">{t("MORE EXPLORATIONS")}</span><a href={`${profile.github}/afa-task-arithmetic`} class="supporting-row"><span class="support-number mono">{t("04")}</span><div><h3>{t("Task Arithmetic")}</h3><p>{t("Task vectors and training-condition trade-offs on CLIP ViT-B/32.")}</p><small>{t("Academic research with Alessandro Vancini & Alessandro Rizzo")}</small></div><span class="support-tags mono">{t("PYTORCH / CLIP")}</span><Arrow diagonal /></a><a href={`${profile.github}/car-rental-microservices-system`} class="supporting-row"><span class="support-number mono">{t("05")}</span><div><h3>{t("Car-rental microservices")}</h3><p>{t("REST APIs, identity and event flows across a distributed backend.")}</p><small>{t("Collaborative academic project · my work: backend integration")}</small></div><span class="support-tags mono">{t("SPRING / KAFKA")}</span><Arrow diagonal /></a></div>
  </section>
  <section class="capabilities wrap" aria-labelledby="capabilities-title"><span class="eyebrow mono">{t("02 / HOW I WORK")}</span><div class="capabilities-intro"><h2 id="capabilities-title">{t("Every problem must be studied to define the requirements, find the model and create the system.")}</h2><p>{t('“I know the pieces fit!” Yes, just like the TOOL song: I like patterns, I like experiments, but above all I like finding solutions to problems.')}</p></div><div class="capability-grid"><div><span class="mono">{t("01 / APPLIED ML")}</span><h3>{t("From data to evidence")}</h3><p>{t("Alignment, feature engineering and evaluated models. Grounded in my multispectral thesis and collaborative ML research.")}</p></div><div><span class="mono">{t("02 / AI APPLICATIONS")}</span><h3>{t("Tools around models")}</h3><p>{t("Local document retrieval, persistent conversations and agent runtimes with explicit limits.")}</p></div><div><span class="mono">{t("03 / BACKEND SYSTEMS")}</span><h3>{t("Pieces that fit together")}</h3><p>{t("APIs, identity, data and event-driven integration. Clear boundaries between components.")}</p></div></div></section>
  <section id="about" class="about wrap" aria-labelledby="about-title"><div class="portrait-block"><img src={assetPath('images/francesco-presentation.webp')} srcset={`${assetPath('images/francesco-presentation-small.webp')} 450w, ${assetPath('images/francesco-presentation.webp')} 900w`} sizes="(max-width: 700px) 90vw, 36vw" alt={t("Francesco presenting his multispectral thesis")} width="900" height="1200" loading="lazy" decoding="async" /><span class="portrait-caption mono">{t("FRANCESCO DI LUCIA / TURIN, ITALY")}</span></div><div class="about-copy"><span class="eyebrow mono">{t("03 / THE PERSON BEHIND THE WORK")}</span><h2 id="about-title">{t("Always looking for opportunities for growth,")}{" "}<em>{t("both personal and professional")}</em></h2><p>{t("I’m Francesco, a computer engineer with an MSc from Politecnico di Torino, specializing in AI and Data Analytics. I like working where models meet software: preparing the data, building the application around it, and checking what actually works.")}</p><p>{t("My thesis took me into multispectral imagery and plant health. Other projects have led me to local AI tools, agent runtimes and distributed backends. I’m especially interested in AI connected to the physical world, and in visual explanations that make complex work easier to follow.")}</p><p>{t("I’ve also supported computer science teaching at Istituto Agnelli. Helping someone understand a difficult idea is a part of engineering I value.")}</p><div class="education"><span class="mono">{t("EDUCATION")}</span><p>{profile.education}<small>{profile.university}</small></p></div></div></section>
  <section id="contact" class="contact" aria-labelledby="contact-title"><div class="wrap"><div class="contact-top"><span class="eyebrow mono">{t("04 / NEXT CONNECTION")}</span><span class="mono">{t("LET’S BUILD SOMETHING USEFUL")}</span></div><h2 id="contact-title">{t("Have a question")}<br />{t("worth")} <em>{t("exploring?")}</em></h2><div class="contact-bottom"><p>{t("Have a project or role in mind?")}<br />{t("I’d be happy to talk.")}</p><a class="email-link" href={`mailto:${profile.email}`}>{t("Say hello")} <Arrow diagonal /></a></div><div class="contact-links"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>{t("GitHub")} <Arrow diagonal /></a></div></div></section>
</Layout>
