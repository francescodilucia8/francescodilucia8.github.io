---
import '@fontsource-variable/manrope';
import '@fontsource/dm-mono/400.css';
import '../styles/global.css';
import { profile } from '../data/portfolio';
import { path } from '../lib/paths';
import Arrow from '../components/Arrow.astro';
interface Props { title?: string; description?: string; home?: boolean; }
const { title = 'Francesco Di Lucia — AI & software engineer', description = 'I build machine-learning systems and the software around them. Explore my work in multispectral imagery, local AI and bounded agent runtimes.' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3eb" /><meta name="description" content={description} />
    <title>{title}</title><link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" />{canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(path('social-card.png'), Astro.site).href} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href={path()} class="wordmark" aria-label="Francesco Di Lucia, home"><span class="monogram" aria-hidden="true">f<span>d</span>l.</span><span>Francesco Di Lucia<span class="wordmark-sub">AI & software engineer</span></span></a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="main-nav" hidden>Menu <span aria-hidden="true">+</span></button>
      <nav id="main-nav" aria-label="Main navigation"><a href={path('#work')}>Work</a><a href={path('#about')}>About</a><a href={path('#contact')} class="nav-contact">Let’s talk <Arrow diagonal /></a></nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap"><span>© {new Date().getFullYear()} Francesco Di Lucia</span><span class="footer-note">Built with care. Kept curious.</span><a href={profile.github}>GitHub <Arrow diagonal /></a></footer>
    <script>
      const toggle=document.querySelector<HTMLButtonElement>('.nav-toggle')!;
      const nav=document.querySelector<HTMLElement>('#main-nav')!;
      const header=document.querySelector<HTMLElement>('.site-header')!;
      toggle.hidden=false;
      header.classList.add('nav-enhanced');
      function close(){toggle.setAttribute('aria-expanded','false');header.classList.remove('nav-open');}
      toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));header.classList.toggle('nav-open',!open);});
      nav.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));
      document.addEventListener('keydown',event=>{if(event.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});
      window.matchMedia('(min-width: 701px)').addEventListener('change',close);
    </script>
  </body>
</html>
