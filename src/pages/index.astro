---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import FieldGlyph from '../components/FieldGlyph.astro';
import ThesisScene from '../components/ThesisScene.astro';
import ProjectDiagram from '../components/ProjectDiagram.astro';
import { projects, profile } from '../data/portfolio';
import { path } from '../lib/paths';
const thesis=projects[0];
---
<Layout home>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-intro mono"><span><i class="status-dot" aria-hidden="true"></i> AI / ML & SOFTWARE ENGINEERING</span><span>{profile.location}</span></div>
    <div class="hero-composition"><div class="hero-heading"><p class="hero-name">Hi, I’m Francesco.</p><h1 id="hero-title">From signal<br />to <em>software.</em></h1></div><div class="hero-art"><FieldGlyph id="hero" /><span class="hero-art-label mono">A DIFFERENT VIEW OF THE SAME WORLD</span></div></div>
    <div class="hero-bottom"><p>I build machine-learning systems and the software around them—from multispectral imagery to local AI tools.</p><a class="primary-link" href="#work">Explore my work <span><Arrow /></span></a></div>
    <div class="hero-foot mono"><span>MODELS. SYSTEMS. THE CONNECTIONS BETWEEN.</span><a href="#work" aria-label="Scroll to selected work">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
  </section>
  <section id="work" class="work-section wrap" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow mono">01 / SELECTED WORK</span><h2 id="work-title">Ideas, made tangible.</h2></div><p>A few projects where I’ve turned<br class="desktop-break" /> a question into a working system.</p></div>
    <article class="featured-project">
      <div class="project-copy"><div class="project-meta mono"><span>01</span><span>{thesis.status}</span></div><h3><a href={path(`work/${thesis.slug}/`)}>{thesis.title}</a></h3><p>{thesis.summary}</p><ul class="stack" aria-label="Technologies">{thesis.stack.map(s=><li>{s}</li>)}</ul><a class="case-link" href={path(`work/${thesis.slug}/`)}>Explore the study <Arrow diagonal /></a></div>
      <ThesisScene />
    </article>
    <div class="project-pair">{projects.slice(1).map(project=><article class="project-card"><ProjectDiagram kind={project.slug} /><div class="project-card-copy"><div class="project-meta mono"><span>{project.number}</span><span>{project.status}</span></div><h3><a href={path(`work/${project.slug}/`)}>{project.title}</a></h3><p>{project.summary}</p><div class="card-bottom"><ul class="stack" aria-label="Technologies">{project.stack.map(s=><li>{s}</li>)}</ul><a class="round-link" href={path(`work/${project.slug}/`)} aria-label={`Read ${project.shortTitle} case study`}><Arrow diagonal /></a></div></div></article>)}</div>
    <div class="supporting"><span class="eyebrow mono">MORE EXPLORATIONS</span><a href={`${profile.github}/afa-task-arithmetic`} class="supporting-row"><span class="support-number mono">04</span><div><h3>Task Arithmetic</h3><p>Task vectors and training-condition trade-offs on CLIP ViT-B/32.</p><small>Academic research with Alessandro Vancini & Alessandro Rizzo</small></div><span class="support-tags mono">PYTORCH / CLIP</span><Arrow diagonal /></a><a href={`${profile.github}/car-rental-microservices-system`} class="supporting-row"><span class="support-number mono">05</span><div><h3>Car-rental microservices</h3><p>REST APIs, identity and event flows across a distributed backend.</p><small>Collaborative academic project · my work: backend integration</small></div><span class="support-tags mono">SPRING / KAFKA</span><Arrow diagonal /></a></div>
  </section>
  <section class="capabilities wrap" aria-labelledby="capabilities-title"><span class="eyebrow mono">02 / HOW I WORK</span><div class="capabilities-intro"><h2 id="capabilities-title">The model is<br /><em>part of the system.</em></h2><p>I’m interested in the connections: how data becomes an experiment, how a model becomes an application, and how we check what actually works.</p></div><div class="capability-grid"><div><span class="mono">01 / APPLIED ML</span><h3>From data to evidence</h3><p>Alignment, feature engineering and evaluated models. Grounded in my multispectral thesis and collaborative ML research.</p></div><div><span class="mono">02 / AI APPLICATIONS</span><h3>Tools around models</h3><p>Local document retrieval, persistent conversations and agent runtimes with explicit limits.</p></div><div><span class="mono">03 / BACKEND SYSTEMS</span><h3>Pieces that fit together</h3><p>APIs, identity, data and event-driven integration. Clear boundaries between components.</p></div></div></section>
  <section id="about" class="about wrap" aria-labelledby="about-title"><div class="portrait-block"><img src={path('images/francesco.webp')} srcset={`${path('images/francesco-small.webp')} 400w, ${path('images/francesco.webp')} 800w`} sizes="(max-width: 700px) 90vw, 36vw" alt="Francesco outdoors with the mountains behind him" width="800" height="1000" loading="lazy" decoding="async" /><span class="portrait-caption mono">FRANCESCO DI LUCIA / TURIN, ITALY</span></div><div class="about-copy"><span class="eyebrow mono">03 / THE PERSON BEHIND THE WORK</span><h2 id="about-title">Curious about<br /><em>how it all fits.</em></h2><p>I’m Francesco, a computer engineer with an MSc from Politecnico di Torino, specializing in AI and Data Analytics. I like working where models meet software: preparing the data, building the application around it, and checking what actually works.</p><p>My thesis took me into multispectral imagery and plant health. Other projects have led me to local AI tools, agent runtimes and distributed backends. I’m especially interested in AI connected to the physical world, and in visual explanations that make complex work easier to follow.</p><p>I’ve also supported computer science teaching at Istituto Agnelli. Helping someone understand a difficult idea is a part of engineering I value.</p><div class="education"><span class="mono">EDUCATION</span><p>{profile.education}<small>{profile.university}</small></p></div></div></section>
  <section id="contact" class="contact" aria-labelledby="contact-title"><div class="wrap"><div class="contact-top"><span class="eyebrow mono">04 / NEXT CONNECTION</span><span class="mono">LET’S BUILD SOMETHING USEFUL</span></div><h2 id="contact-title">Have a question<br />worth <em>exploring?</em></h2><div class="contact-bottom"><p>Have a project or role in mind?<br />I’d be happy to talk.</p><a class="email-link" href={`mailto:${profile.email}`}>Say hello <Arrow diagonal /></a></div><div class="contact-links"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>GitHub <Arrow diagonal /></a></div></div></section>
</Layout>
